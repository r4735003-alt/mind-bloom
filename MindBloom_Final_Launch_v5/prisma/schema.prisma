generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { PARENT THERAPIST OWNER }
enum PaymentStatus { PENDING APPROVED REJECTED }
model User { id String @id @default(cuid()) email String @unique passwordHash String name String? role Role @default(PARENT) createdAt DateTime @default(now()) children Child[] payments PaymentRequest[] subscriptions Subscription[] auditLogs AuditLog[] }
model Child { id String @id @default(cuid()) parentId String parent User @relation(fields:[parentId],references:[id],onDelete:Cascade) name String ageBand String focus String? createdAt DateTime @default(now()) attempts Attempt[] goals Goal[] }
model Activity { id String @id @default(cuid()) title String skill String ageBands String description String active Boolean @default(true) attempts Attempt[] }
model Attempt { id String @id @default(cuid()) childId String activityId String score Int @default(0) createdAt DateTime @default(now()) child Child @relation(fields:[childId],references:[id],onDelete:Cascade) activity Activity @relation(fields:[activityId],references:[id],onDelete:Cascade) }
model Goal { id String @id @default(cuid()) childId String title String progress Int @default(0) target Int @default(100) createdAt DateTime @default(now()) child Child @relation(fields:[childId],references:[id],onDelete:Cascade) }
model PaymentRequest { id String @id @default(cuid()) userId String trxId String @unique amountPkr Int @default(799) method String @default("NAYAPAY") status PaymentStatus @default(PENDING) submittedAt DateTime @default(now()) reviewedAt DateTime? reviewedById String? rejectionReason String? user User @relation(fields:[userId],references:[id],onDelete:Cascade) subscription Subscription? }
model Subscription { id String @id @default(cuid()) userId String startAt DateTime endAt DateTime sourcePaymentId String? @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) sourcePayment PaymentRequest? @relation(fields:[sourcePaymentId],references:[id]) }
model AuditLog { id String @id @default(cuid()) actorId String? action String entityType String entityId String? metadata Json? createdAt DateTime @default(now()) actor User? @relation(fields:[actorId],references:[id]) }
